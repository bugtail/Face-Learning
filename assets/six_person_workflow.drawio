        <mxCell id="eBC_merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#46664C;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.45;entryX=0;entryY=0.42;" edge="1" parent="1" source="BC" target="merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eDE_merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#66537E;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.58;entryX=0;entryY=0.78;" edge="1" parent="1" source="DE" target="merge">
