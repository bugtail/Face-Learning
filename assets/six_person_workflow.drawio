<mxCell id="text-9" value="同組不跨折；四種方法共用五折。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="437.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="input-to-pairs" style="edgeStyle=none;rounded=0;strokeColor=#9aa79e;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="487" as="sourcePoint"/><mxPoint x="200" y="519" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="text-10" value="02　兩組各自實驗與 review" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=14;fontStyle=1;fontColor=#59655d;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="532.6" width="360" height="21" as="geometry"/></mxCell>
<mxCell id="bc" value="" style="rounded=1;arcSize=10;fillColor=#f0f5ee;strokeColor=#d7dfd8;" vertex="1" parent="1"><mxGeometry x="20" y="568" width="360" height="260" as="geometry"/></mxCell>
<mxCell id="text-11" value="B / C　降維實驗" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;fontColor=#40664c;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="583.8" width="312" height="33" as="geometry"/></mxCell>
<mxCell id="text-12" value="B：PCA　　C：Fisher LDA" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=17;fontStyle=1;fontColor=#40664c;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="627.3" width="312" height="25.5" as="geometry"/></mxCell>
<mxCell id="text-13" value="每折只用 train fit，再投影 validation。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="665.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-14" value="兩人互查維度、秩與投影結果。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="695.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-15" value="交付：reducer API" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=1;fontColor=#40664c;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="740.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-16" value="reduction_summary.csv、合成測試" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="770.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="bc-to-de" style="edgeStyle=none;rounded=0;strokeColor=#40664c;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="828" as="sourcePoint"/><mxPoint x="200" y="851" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="text-17" value="B/C 提供降維介面，D/E 接著跑 folds" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=center;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=14;fontStyle=0;fontColor=#59655d;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="859.6" width="360" height="21" as="geometry"/></mxCell>
<mxCell id="de" value="" style="rounded=1;arcSize=10;fillColor=#f5f0f6;strokeColor=#d7dfd8;" vertex="1" parent="1"><mxGeometry x="20" y="892" width="360" height="260" as="geometry"/></mxCell>
<mxCell id="text-18" value="D / E　分類器實驗" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;fontColor=#705a76;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="907.8" width="312" height="33" as="geometry"/></mxCell>
<mxCell id="text-19" value="D：Bayes　　E：MLP" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=17;fontStyle=1;fontColor=#705a76;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="951.3" width="312" height="25.5" as="geometry"/></mxCell>
<mxCell id="text-20" value="前期先用合成特徵，同步測分類介面。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="989.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-21" value="接 B/C 輸出後，跑共同五折與 review。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1019.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-22" value="交付：classifier API" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=1;fontColor=#705a76;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1064.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-23" value="classifier_summary.csv、各折預測" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1094.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="bc-to-af" style="edgeStyle=none;rounded=0;strokeColor=#40664c;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="802" as="sourcePoint"/><mxPoint x="380" y="1380" as="targetPoint"/><Array as="points"><mxPoint x="392" y="802"/><mxPoint x="392" y="1380"/></Array></mxGeometry></mxCell>
<mxCell id="de-to-af" style="edgeStyle=none;rounded=0;strokeColor=#705a76;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1152" as="sourcePoint"/><mxPoint x="200" y="1230" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="text-24" value="03　A/F 匯整" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=14;fontStyle=1;fontColor=#59655d;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1192.6" width="360" height="21" as="geometry"/></mxCell>
<mxCell id="af" value="" style="rounded=1;arcSize=10;fillColor=#eaf1eb;strokeColor=#d7dfd8;" vertex="1" parent="1"><mxGeometry x="20" y="1230" width="360" height="202" as="geometry"/></mxCell>
<mxCell id="text-25" value="A / F　匯整兩組實驗" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;fontColor=#40664c;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1245.8" width="312" height="33" as="geometry"/></mxCell>
<mxCell id="text-26" value="整合四種管線，核對五折數據。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1294.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-27" value="整理維度、參數量、準確率與時間。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1324.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-28" value="確認兩組成果後，鎖定程式與設定。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1354.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-29" value="由 A/F 共同驗收。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=1;fontColor=#40664c;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1386.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="af-to-test" style="edgeStyle=none;rounded=0;strokeColor=#202923;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1432" as="sourcePoint"/><mxPoint x="200" y="1500" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="text-30" value="04　最終交付" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=14;fontStyle=1;fontColor=#59655d;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1464.6" width="360" height="21" as="geometry"/></mxCell>
<mxCell id="test" value="" style="rounded=1;arcSize=10;fillColor=#faf3e9;strokeColor=#d7dfd8;" vertex="1" parent="1"><mxGeometry x="20" y="1500" width="360" height="145" as="geometry"/></mxCell>
<mxCell id="text-31" value="F　正式測試" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;fontColor=#85603a;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1515.8" width="312" height="33" as="geometry"/></mxCell>
<mxCell id="text-32" value="設定鎖定後，A 才交付正式測試集。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1564.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-33" value="全部訓練圖重新 fit，再評估測試圖。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1595.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="test-to-report" style="edgeStyle=none;rounded=0;strokeColor=#85603a;strokeWidth=2;endArrow=open;endFill=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="1645" as="sourcePoint"/><mxPoint x="200" y="1695" as="targetPoint"/><Array as="points"></Array></mxGeometry></mxCell>
<mxCell id="report" value="" style="rounded=1;arcSize=10;fillColor=#f3f3ef;strokeColor=#d7dfd8;" vertex="1" parent="1"><mxGeometry x="20" y="1695" width="360" height="145" as="geometry"/></mxCell>
<mxCell id="text-34" value="全員　簡報與書面報告" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1710.8" width="312" height="33" as="geometry"/></mxCell>
<mxCell id="text-35" value="B/C、D/E 撰寫方法與實驗結果。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1759.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-36" value="A/F 統一風格、名稱、設定與數字。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=0;fontColor=#202923;spacing=0;" vertex="1" parent="1"><mxGeometry x="44" y="1790.4" width="312" height="24" as="geometry"/></mxCell>
<mxCell id="text-37" value="正式測試集不進入五折交叉驗證。" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=14;fontStyle=0;fontColor=#59655d;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1868.6" width="360" height="21" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
